# mgk Indexer — devnet environment
#
# Copy this file to `.env` to override the defaults baked into `main.ts`.
# The indexer loads `.env` automatically via `dotenv` on startup.

# Solana JSON-RPC endpoint. Default: Solana public devnet.
# Use a paid endpoint (Helius/Triton/QuickNode) for better rate limits.
RPC_URL=https://api.devnet.solana.com

# Deployed mgk programs (fresh program IDs, ADR 0004; match deployments/devnet.json).
CORE_PROGRAM_ID=9gr1GDrBF8MQMGSsbHYnUMTkvpzNLANiP5ZHhDKKAaDT
MATCHER_PROGRAM_ID=68MQqdugxZQA2F8GahhWZEusPnHbrfAXjqq2V9VCz8tK

# NOTE (ADR 0004): the registry, vault and book addresses below belong to the
# abandoned deployment under the old program IDs. They are replaced by
# `deployments/devnet.json` once the manifest loader lands (separate spec-13 ticket).
# Protocol accounts (registry/vault = core PDAs; book = matcher-owned keypair).
REGISTRY_ADDRESS=CbsfrRS2rYE2qgJbi7MM6mLzARUy8cDiYmHW2o12jYJA
VAULT_ADDRESS=9qe7TkRxDXHo3dywPKiiY1jwSBnFuSPHmGTWhcP8ttXE
BOOK_ADDRESS=J33Y6yo6AZM6JKLEw89tN1kPmyEADqWWjGxb1aAW915j

# Logging
LOG_LEVEL=info
