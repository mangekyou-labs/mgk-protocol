# mgk Frontend — devnet environment
#
# Copy this file to `.env.local` to override the devnet defaults baked into
# `lib/config.ts`. The frontend boots with the devnet defaults when no
# `.env.local` is present.
#
# All vars must be prefixed with `NEXT_PUBLIC_` to be inlined into the browser
# bundle at build time (Next.js convention).

# Solana JSON-RPC endpoint. Default: Solana public devnet.
# For better rate limits, use Helius / Triton / QuickNode and paste the URL here.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Deployed mgk programs (devnet). Fresh program IDs per ADR 0004; these match
# `deployments/devnet.json` and `programs/common/src/program_ids.rs`.
NEXT_PUBLIC_CORE_PROGRAM_ID=9gr1GDrBF8MQMGSsbHYnUMTkvpzNLANiP5ZHhDKKAaDT
NEXT_PUBLIC_MATCHER_PROGRAM_ID=68MQqdugxZQA2F8GahhWZEusPnHbrfAXjqq2V9VCz8tK
NEXT_PUBLIC_ORACLE_PROGRAM_ID=GLAu9n48oqnVRKHNoqfpek3kZyGUJTJRPQKo7mF3qWmm

# Indexer REST + WebSocket base. Default: localhost:4000 (T1.3 healthz port).
# For devnet, point this at the hosted indexer once M4 is shipped.
NEXT_PUBLIC_INDEXER_URL=http://localhost:4000
